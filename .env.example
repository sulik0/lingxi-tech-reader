# Copy to .dev.vars for local Cloudflare Worker development.
# Keep real credentials out of Git and client bundles.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Single-owner automation. Keep the management token secret (24+ characters).
AUTOMATION_TOKEN=
# Explicitly allow each feed host, including your own WeWe RSS service.
FEED_ALLOWED_HOSTS=www.qbitai.com,www.geekpark.net,baoyu.io
# Email delivery via Resend. EMAIL_FROM must use an authorized sending domain.
RESEND_API_KEY=
EMAIL_FROM=
# Bot credentials remain on the server; the UI only enables/disables channels.
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
